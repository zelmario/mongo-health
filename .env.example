# Secrets for the collector, kept out of config.json. Copy to .env; never commit it.

# An Atlas API key with Project Read Only on the project, used for every Atlas cluster that
# has no key of its own in the config.
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=

# The password for the "smtp" block in the config, if it has one.
SMTP_PASSWORD=

# Optional: a URL pinged after every successful round (healthchecks.io and similar), so
# something outside this machine notices when it stops.
HEARTBEAT_URL=
