{
  "notify": ["you@example.com"],
  "retention_days": 365,
  "report_url": "https://mongo-reports.example.com",
  "smtp": {
    "host": "smtp.example.com",
    "port": 587,
    "from": "MongoDB collector <collector@example.com>",
    "user": "collector@example.com"
  },
  "clusters": [
    {
      "id": "orders-prod",
      "source": {
        "type": "atlas",
        "group_id": "YOUR_ATLAS_PROJECT_ID",
        "replica_set": "atlas-xxxxxx-shard-0"
      }
    },
    {
      "id": "rs-staging",
      "notify": ["staging-team@example.com"],
      "retention_days": 90,
      "mute": ["collection-scans-sustained"],
      "source": {
        "type": "directory",
        "path": "/mnt/ftdc/rs-staging"
      }
    }
  ]
}
