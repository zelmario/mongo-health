# Hourly, and deliberately out of step with the collector: a watchdog that runs at the same
# moment as the thing it watches keeps catching it mid-run.

[Unit]
Description=mongo-health — watchdog schedule

[Timer]
OnCalendar=*-*-* *:35:00
Persistent=true
Unit=bighole-watchdog.service

[Install]
WantedBy=timers.target
